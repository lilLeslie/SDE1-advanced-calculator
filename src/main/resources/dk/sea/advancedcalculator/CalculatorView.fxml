      </HBox>
      <HBox layoutX="10.0" layoutY="120.0" prefHeight="100.0" prefWidth="394.0">
         <children>
            <Button fx:id="btnSeven" mnemonicParsing="false" onAction="#onBtnSevenClick" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #584D99; -fx-background-radius: 0;" text="7" textFill="WHITE">
               <font>
                  <Font name="Poppins Regular" size="36.0" />
               </font>
            </Button>
            <Button fx:id="btnEight" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onBtnEightClick" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #584D99; -fx-background-radius: 0;" text="8" textFill="WHITE">
