            </Button>
            <Button fx:id="btnEquals" layoutX="114.0" layoutY="10.0" mnemonicParsing="false" onAction="#onBtnEqualsClick" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #6B82F2; -fx-background-radius: 0;" text="=" textFill="WHITE">
               <font>
                  <Font name="Poppins Regular" size="36.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
