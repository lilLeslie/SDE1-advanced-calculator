            <Button fx:id="btnFour" mnemonicParsing="false" onAction="#onBtnFourClick" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #584D99; -fx-background-radius: 0;" text="4" textFill="WHITE">
