                  <Font name="Poppins Regular" size="36.0" />
               </font>
            </Button>
            <Button fx:id="btnSubtract" layoutX="114.0" layoutY="10.0" mnemonicParsing="false" onAction="#onBtnSubtractClick" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #6B82F2; -fx-background-radius: 0;" text="-" textFill="WHITE">
               <font>
                  <Font name="Poppins Regular" size="36.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <HBox layoutX="10.0" layoutY="360.0" prefHeight="100.0" prefWidth="394.0">
         <children>
            <Button fx:id="btnOne" mnemonicParsing="false" onAction="#onBtnOneClick" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #584D99; -fx-background-radius: 0;" text="1" textFill="WHITE">
               <font>
                  <Font name="Poppins Regular" size="36.0" />
               </font>
            </Button>
            <Button fx:id="btnTwo" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onBtnTwoClick" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #584D99; -fx-background-radius: 0;" text="2" textFill="WHITE">
               <font>
                  <Font name="Poppins Regular" size="36.0" />
               </font>
            </Button>
            <Button fx:id="btnThree" layoutX="62.0" layoutY="10.0" mnemonicParsing="false" onAction="#onBtnThreeClick" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #584D99; -fx-background-radius: 0;" text="3" textFill="WHITE">
