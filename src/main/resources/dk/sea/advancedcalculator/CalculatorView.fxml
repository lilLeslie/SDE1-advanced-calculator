               <font>
                  <Font name="Poppins Regular" size="36.0" />
               </font>
            </Button>
            <Button fx:id="btnSix" layoutX="62.0" layoutY="10.0" mnemonicParsing="false" onAction="#onBtnSixClick" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #584D99; -fx-background-radius: 0;" text="6" textFill="WHITE">
